      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "app": {
      "$ref": "#/$defs/AppRef"
    },
    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParamSpec"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutputSpec"
      },
      "title": "Outputs",
      "type": "array"
    },
    "business_outcomes": {
      "default": [],
