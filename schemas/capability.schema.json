        "value": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "literal": "#/$defs/LiteralValue",
                  "param": "#/$defs/ParamValue",
                  "secret": "#/$defs/SecretValue"
                },
                "propertyName": "source"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/LiteralValue"
                },
                {
                  "$ref": "#/$defs/ParamValue"
                },
                {
                  "$ref": "#/$defs/SecretValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "extract": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extraction"
