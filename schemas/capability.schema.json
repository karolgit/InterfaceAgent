      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "success": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Checkpoint"
      },
      "title": "Success",
      "type": "array"
    },
    "outcome_rules": {
      "default": [],
