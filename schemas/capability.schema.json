      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "default": {
            "window": "main",
            "container": null
          }
        },
        "strategies": {
          "items": {
            "discriminator": {
              "mapping": {
                "a11y": "#/$defs/A11yLocator",
                "coords": "#/$defs/CoordLocator",
                "group": "#/$defs/GroupLocator",
                "label": "#/$defs/LabelLocator",
                "path": "#/$defs/PathLocator"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/A11yLocator"
              },
              {
                "$ref": "#/$defs/LabelLocator"
              },
              {
                "$ref": "#/$defs/GroupLocator"
              },
              {
                "$ref": "#/$defs/PathLocator"
              },
              {
                "$ref": "#/$defs/CoordLocator"
              }
            ]
          },
          "title": "Strategies",
          "type": "array"
        }
      },
      "required": [
        "description",
        "strategies"
      ],
      "title": "Target",
      "type": "object"
    }
