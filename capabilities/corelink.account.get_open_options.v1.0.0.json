{
  "schema_version": "cua.capability/v1",
  "id": "corelink.account.get_open_options",
  "version": "1.0.0",
  "status": "draft",
  "title": "List account types that can be opened, and the member's funding shares",
  "description": "Open the Open Sub-Account screen for a member and read, without posting anything, which account types this credit union offers and which of the member's shares can fund a new account. Call this before opening an account so only valid choices are offered. Read-only.",
  "app": {
    "product": "CoreLink",
    "versions": "7.4.1",
    "surface": "java-swing",
    "profile": "corelink"
  },
  "inputs": [
    {
      "name": "member_number",
      "type": "string",
      "description": "5-digit member number",
      "pattern": "^\\d{5}$",
      "required": true,
      "sensitive": true
    }
  ],
  "outputs": [
    {
      "name": "account_types",
      "type": "list",
      "description": "Account types offered by this credit union",
      "sensitive": false
    },
    {
      "name": "fund_from",
      "type": "list",
      "description": "Member's shares that can fund it, e.g. 'S01 Share Savings'",
      "sensitive": false
    }
  ],
  "business_outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with that number."
    },
    {
      "code": "MEMBER_RESTRICTED",
      "description": "Member is restricted; supervisor review required before servicing."
    },
    {
      "code": "MEMBER_CLOSED",
      "description": "Membership is closed."
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The signed-on operator is not authorized for this transaction."
    }
  ],
  "risk": "read_only",
  "preconditions": [
    "signed_on",
    "no_modal_dialog"
  ],
