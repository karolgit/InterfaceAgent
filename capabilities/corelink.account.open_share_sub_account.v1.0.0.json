{
  "schema_version": "cua.capability/v1",
  "id": "corelink.account.open_share_sub_account",
  "version": "1.0.0",
  "status": "draft",
  "title": "Open a share sub-account and reach confirmation",
  "description": "Open a new share sub-account (certificate, money market, club) for an existing member, funded from one of the member's existing shares, and return the confirmation number. IRREVERSIBLE: posts a transaction.",
  "app": {
    "product": "CoreLink",
    "versions": "7.4.1",
    "surface": "java-swing",
    "profile": "corelink"
  },
  "inputs": [
    {
      "name": "member_number",
      "type": "string",
      "description": "5-digit member number",
      "pattern": "^\\d{5}$",
      "required": true,
      "sensitive": true
    },
    {
      "name": "account_type",
      "type": "enum",
      "description": "Product to open",
      "enum": [
        "Share Certificate",
        "Money Market",
        "Christmas Club",
        "Holiday Club",
        "Youth Savings"
      ],
      "required": true,
      "sensitive": false
    },
    {
      "name": "initial_deposit",
      "type": "decimal",
      "description": "Opening deposit in USD",
      "pattern": "^\\d+(\\.\\d{2})?$",
      "required": true,
      "sensitive": false
    },
    {
      "name": "fund_from",
      "type": "string",
      "description": "Suffix of the funding share",
      "pattern": "^S\\d{2}$",
      "required": true,
      "sensitive": false
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "CoreLink confirmation number for the posted transaction",
      "sensitive": false
    }
  ],
  "business_outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with that number."
    },
    {
      "code": "MEMBER_RESTRICTED",
      "description": "Member is restricted; supervisor review required before servicing."
    },
    {
      "code": "MEMBER_CLOSED",
      "description": "Membership is closed."
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The signed-on operator is not authorized for this transaction."
    },
    {
      "code": "VALIDATION_ERROR",
      "description": "The application rejected an input value."
    },
    {
      "code": "OPERATOR_DECLINED",
      "description": ""
    }
  ],
  "risk": "irreversible",
  "preconditions": [
    "signed_on",
    "no_modal_dialog"
  ],
