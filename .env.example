# Copy this file to .env (same folder) and fill in what you need. .env is gitignored.
# Everything below is optional: replay, the tests, the operator console, and the member
# assistant's offline mode run with no keys at all.

# --- LLM for discovery (set ONE; remove the leading "# ") ---------------------------
# Anthropic API key from the Claude Console (platform.claude.com > API keys).
# Note: claude.ai plan "usage credits" do not fund API keys; add API credits in the Console.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CUA_MODEL=claude-opus-5            # optional model override (e.g. claude-sonnet-5 is cheaper)

# Google Gemini key from aistudio.google.com (free tier available).
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-flash-latest

# Force a planner when both keys are set: claude | gemini
# CUA_PLANNER=claude

# --- CoreLink mock app (FAKE demo operator; these are the defaults) -----------------
# CORELINK_OPERATOR_ID=teller01
# CORELINK_OPERATOR_PASSWORD=demo123

# --- Optional ------------------------------------------------------------------------
# CUA_PORT=8740                      # bridge port; change it to run tests beside a manually opened app
# PORTAL_MODEL=claude-sonnet-5       # cheaper model for the member assistant (about 2-5 cents/question on Opus)
# CUA_DEMO_DELAY_MS=700              # slow replays down for screen recording (never in production)
